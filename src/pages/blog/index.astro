---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Blog | Bunga Ice"
  description="Artikel, cerita, tips, dan informasi terbaru dari Bunga Ice."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Blog</p>

      <h1>
        Cerita dan informasi dari Bunga Ice
      </h1>

      <p>
        Temukan berbagai artikel, tips, cerita, dan informasi
        yang kami bagikan untuk Anda.
      </p>
    </div>
  </section>

  <section class="section blog-section">
    <div class="container">
      {
        articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map((article) => (
              <article class="article-card">
                <a
                  href={`/blog/${article.data.slug}/`}
                  class="article-image"
                >
                  {article.data.image ? (
                    <img
                      src={article.data.image}
                      alt={article.data.title}
                      loading="lazy"
                    />
                  ) : (
                    <div class="image-placeholder">
                      Bunga Ice
                    </div>
                  )}
                </a>

                <div class="article-content">
                  <div class="article-meta">
                    <span>{article.data.category}</span>

                    <time datetime={article.data.date.toISOString()}>
                      {article.data.date.toLocaleDateString("id-ID", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                      })}
                    </time>
                  </div>

                  <h2>
                    <a href={`/blog/${article.data.slug}/`}>
                      {article.data.title}
                    </a>
                  </h2>

                  <p>{article.data.excerpt}</p>

                  <a
                    href={`/blog/${article.data.slug}/`}
                    class="read-more"
                  >
                    Baca Artikel
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h2>Belum ada artikel</h2>
            <p>
              Artikel akan ditampilkan di halaman ini setelah
              konten ditambahkan.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: 90px 70px;
  }

  .page-hero h1 {
    max-width: 800px;
    margin-bottom: 20px;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
  }

  .page-hero > .container > p:last-child {
    max-width: 650px;
    margin-bottom: 0;
    color: var(--color-text-soft);
    font-size: 1.1rem;
  }

  .blog-section {
    background: var(--color-muted);
  }

  .articles-grid {
    display: grid;
    gap: 20px;
  }

  .article-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .article-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-muted);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .article-card:hover .article-image img {
    transform: scale(1.04);
  }

  .image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 220px;
    place-items: center;
    background: var(--color-muted);
    color: var(--color-text-soft);
    font-weight: 700;
  }

  .article-content {
    padding: 24px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .article-meta span {
    color: var(--color-primary);
    font-weight: 700;
  }

  .article-content h2 {
    margin-bottom: 12px;
    font-size: 1.4rem;
  }

  .article-content h2 a:hover {
    color: var(--color-primary);
  }

  .article-content p {
    margin-bottom: 20px;
    color: var(--color-text-soft);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .read-more span {
    transition: transform 180ms ease;
  }

  .read-more:hover span {
    transform: translateX(4px);
  }

  .empty-state {
    padding: 60px 30px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: center;
  }

  .empty-state h2 {
    margin-bottom: 10px;
  }

  .empty-state p {
    margin-bottom: 0;
    color: var(--color-text-soft);
  }

  @media (min-width: 700px) {
    .page-hero {
      padding-block: 120px 90px;
    }

    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
