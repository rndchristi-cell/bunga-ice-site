---
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = [
  {
    title: "Mengenal Bunga Ice Lebih Dekat",
    excerpt:
      "Cerita singkat tentang Bunga Ice, latar belakang, dan apa yang kami tawarkan.",
    date: "12 September 2026",
    category: "Tentang Kami",
    image: "/images/article-1.jpg",
    href: "/blog/mengenal-bunga-ice/",
  },
  {
    title: "Tips Memilih Produk yang Tepat",
    excerpt:
      "Beberapa hal yang bisa diperhatikan sebelum memilih produk sesuai kebutuhan.",
    date: "8 September 2026",
    category: "Tips",
    image: "/images/article-2.jpg",
    href: "/blog/tips-memilih-produk/",
  },
  {
    title: "Cerita dan Aktivitas Bunga Ice",
    excerpt:
      "Berbagai cerita, aktivitas, dan informasi terbaru dari Bunga Ice.",
    date: "3 September 2026",
    category: "Cerita",
    image: "/images/article-3.jpg",
    href: "/blog/cerita-dan-aktivitas-bunga-ice/",
  },
  {
    title: "Informasi Terbaru dari Bunga Ice",
    excerpt:
      "Ikuti berbagai informasi dan kabar terbaru yang akan kami bagikan.",
    date: "28 Agustus 2026",
    category: "Informasi",
    image: "/images/article-4.jpg",
    href: "/blog/informasi-terbaru/",
  },
  {
    title: "Tips dan Informasi untuk Pelanggan",
    excerpt:
      "Berbagai tips sederhana dan informasi yang mungkin berguna bagi Anda.",
    date: "22 Agustus 2026",
    category: "Tips",
    image: "/images/article-5.jpg",
    href: "/blog/tips-dan-informasi/",
  },
  {
    title: "Di Balik Bunga Ice",
    excerpt:
      "Cerita mengenai aktivitas, proses, dan perjalanan yang ada di balik Bunga Ice.",
    date: "15 Agustus 2026",
    category: "Cerita",
    image: "/images/article-6.jpg",
    href: "/blog/di-balik-bunga-ice/",
  },
];
---

<BaseLayout
  title="Blog | Bunga Ice"
  description="Artikel, cerita, tips, dan informasi terbaru dari Bunga Ice."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Blog</p>

      <h1>
        Cerita dan informasi dari Bunga Ice
      </h1>

      <p>
        Temukan berbagai artikel, tips, cerita, dan informasi
        yang kami bagikan untuk Anda.
      </p>
    </div>
  </section>

  <section class="section blog-section">
    <div class="container">
      <div class="articles-grid">
        {
          articles.map((article) => (
            <article class="article-card">
              <a href={article.href} class="article-image">
                <img
                  src={article.image}
                  alt={article.title}
                  loading="lazy"
                />
              </a>

              <div class="article-content">
                <div class="article-meta">
                  <span>{article.category}</span>
                  <time>{article.date}</time>
                </div>

                <h2>
                  <a href={article.href}>{article.title}</a>
                </h2>

                <p>{article.excerpt}</p>

                <a href={article.href} class="read-more">
                  Baca Artikel
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: 90px 70px;
  }

  .page-hero h1 {
    max-width: 800px;
    margin-bottom: 20px;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
  }

  .page-hero > .container > p:last-child {
    max-width: 650px;
    margin-bottom: 0;
    color: var(--color-text-soft);
    font-size: 1.1rem;
  }

  .blog-section {
    background: var(--color-muted);
  }

  .articles-grid {
    display: grid;
    gap: 20px;
  }

  .article-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .article-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-muted);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .article-card:hover .article-image img {
    transform: scale(1.04);
  }

  .article-content {
    padding: 24px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .article-meta span {
    color: var(--color-primary);
    font-weight: 700;
  }

  .article-content h2 {
    margin-bottom: 12px;
    font-size: 1.4rem;
  }

  .article-content h2 a:hover {
    color: var(--color-primary);
  }

  .article-content p {
    margin-bottom: 20px;
    color: var(--color-text-soft);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .read-more span {
    transition: transform 180ms ease;
  }

  .read-more:hover span {
    transform: translateX(4px);
  }

  @media (min-width: 700px) {
    .page-hero {
      padding-block: 120px 90px;
    }

    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
