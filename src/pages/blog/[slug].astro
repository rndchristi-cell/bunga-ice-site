---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: {
      slug: article.data.slug,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const title = article.data.seoTitle || `${article.data.title} | Bunga Ice`;
const description =
  article.data.seoDescription || article.data.excerpt;
---

<BaseLayout
  title={title}
  description={description}
  image={article.data.image}
>
  <article class="article-page">
    <header class="article-header">
      <div class="container">
        <a href="/blog/" class="back-link">
          ← Kembali ke Blog
        </a>

        <div class="article-meta">
          <span>{article.data.category}</span>

          <time datetime={article.data.date.toISOString()}>
            {article.data.date.toLocaleDateString("id-ID", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </time>
        </div>

        <h1>{article.data.title}</h1>

        <p class="article-excerpt">
          {article.data.excerpt}
        </p>
      </div>
    </header>

    {article.data.image && (
      <div class="article-cover container">
        <img
          src={article.data.image}
          alt={article.data.title}
        />
      </div>
    )}

    <div class="container article-layout">
      <div class="article-body">
        <Content />
      </div>

      <aside class="article-sidebar">
        <div class="sidebar-card">
          <p class="eyebrow">Bunga Ice</p>

          <h2>
            Temukan artikel lainnya
          </h2>

          <p>
            Jelajahi berbagai cerita, tips, dan informasi lainnya
            dari Bunga Ice.
          </p>

          <a href="/blog/" class="button button-primary">
            Lihat Semua Artikel
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    padding-block: 70px 50px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 30px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .back-link:hover {
    color: var(--color-primary-dark);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--color-text-soft);
    font-size: 0.85rem;
  }

  .article-meta span {
    color: var(--color-primary);
    font-weight: 700;
  }

  .article-header h1 {
    max-width: 850px;
    margin-bottom: 20px;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
  }

  .article-excerpt {
    max-width: 720px;
    margin-bottom: 0;
    color: var(--color-text-soft);
    font-size: 1.15rem;
  }

  .article-cover {
    margin-bottom: 60px;
  }

  .article-cover img {
    width: 100%;
    max-height: 620px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .article-layout {
    display: grid;
    gap: 50px;
    padding-bottom: 100px;
  }

  .article-body {
    max-width: 760px;
    font-size: 1.05rem;
  }

  .article-body :global(h2) {
    margin-top: 42px;
    margin-bottom: 14px;
    font-size: 1.8rem;
  }

  .article-body :global(h3) {
    margin-top: 32px;
    margin-bottom: 12px;
    font-size: 1.4rem;
  }

  .article-body :global(p) {
    margin-bottom: 20px;
    color: var(--color-text-soft);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 24px;
    padding-left: 24px;
    color: var(--color-text-soft);
  }

  .article-body :global(li) {
    margin-bottom: 8px;
  }

  .article-body :global(a) {
    color: var(--color-primary);
    font-weight: 600;
  }

  .article-sidebar {
    align-self: start;
  }

  .sidebar-card {
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-muted);
  }

  .sidebar-card .eyebrow {
    margin-bottom: 10px;
  }

  .sidebar-card h2 {
    margin-bottom: 12px;
    font-size: 1.5rem;
  }

  .sidebar-card p:not(.eyebrow) {
    margin-bottom: 22px;
    color: var(--color-text-soft);
  }

  @media (min-width: 768px) {
    .article-header {
      padding-block: 100px 70px;
    }

    .article-layout {
      grid-template-columns: minmax(0, 1fr) 280px;
      align-items: start;
      gap: 80px;
    }

    .article-sidebar {
      position: sticky;
      top: 110px;
    }
  }
</style>
