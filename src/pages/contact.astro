---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Bunga Ice"
  description="Hubungi Bunga Ice untuk mendapatkan informasi lebih lanjut mengenai produk dan layanan kami."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>

      <h1>
        Mari terhubung dengan kami
      </h1>

      <p>
        Punya pertanyaan atau ingin mengetahui lebih banyak tentang
        Bunga Ice? Silakan hubungi kami melalui informasi yang tersedia.
      </p>
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-intro">
        <p class="eyebrow">Hubungi Kami</p>

        <h2>
          Kami siap membantu
        </h2>

        <p>
          Halaman ini nantinya dapat digunakan untuk menampilkan
          informasi kontak, lokasi, jam operasional, media sosial,
          serta pilihan komunikasi lainnya.
        </p>
      </div>

      <div class="contact-cards">
        <article class="contact-card">
          <span class="contact-label">Email</span>

          <h3>
            hello@bungaice.example
          </h3>

          <p>
            Untuk pertanyaan dan informasi umum.
          </p>
        </article>

        <article class="contact-card">
          <span class="contact-label">Lokasi</span>

          <h3>
            Indonesia
          </h3>

          <p>
            Informasi alamat lengkap akan ditambahkan nanti.
          </p>
        </article>

        <article class="contact-card">
          <span class="contact-label">Jam Operasional</span>

          <h3>
            Senin – Sabtu
          </h3>

          <p>
            Jam operasional akan disesuaikan dengan informasi bisnis.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section contact-cta">
    <div class="container">
      <div class="cta-card">
        <div>
          <p class="eyebrow">Informasi</p>

          <h2>
            Ada yang ingin ditanyakan?
          </h2>

          <p>
            Detail kontak dan tombol komunikasi akan kita lengkapi
            setelah informasi bisnis final sudah siap.
          </p>
        </div>

        <a href="/" class="button button-secondary">
          Kembali ke Home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: 90px 70px;
  }

  .page-hero h1 {
    max-width: 800px;
    margin-bottom: 20px;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
  }

  .page-hero > .container > p:last-child {
    max-width: 650px;
    margin-bottom: 0;
    color: var(--color-text-soft);
    font-size: 1.1rem;
  }

  .contact-section {
    background: var(--color-muted);
  }

  .contact-grid {
    display: grid;
    gap: 40px;
  }

  .contact-intro {
    max-width: 600px;
  }

  .contact-intro h2 {
    margin-bottom: 16px;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .contact-intro > p:last-child {
    margin-bottom: 0;
    color: var(--color-text-soft);
  }

  .contact-cards {
    display: grid;
    gap: 16px;
  }

  .contact-card {
    padding: 28px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .contact-label {
    display: block;
    margin-bottom: 10px;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-card h3 {
    margin-bottom: 8px;
    font-size: 1.2rem;
  }

  .contact-card p {
    margin-bottom: 0;
    color: var(--color-text-soft);
  }

  .contact-cta {
    background: var(--color-bg);
  }

  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--color-primary);
    color: #fff;
  }

  .cta-card .eyebrow {
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.72);
  }

  .cta-card h2 {
    margin-bottom: 12px;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .cta-card p:not(.eyebrow) {
    max-width: 620px;
    margin-bottom: 0;
    color: rgba(255, 255, 255, 0.82);
  }

  .cta-card .button-secondary {
    flex-shrink: 0;
    border-color: rgba(255, 255, 255, 0.35);
    background: transparent;
    color: #fff;
  }

  .cta-card .button-secondary:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .page-hero {
      padding-block: 120px 90px;
    }

    .contact-grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 80px;
      align-items: start;
    }
  }

  @media (max-width: 767px) {
    .cta-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
