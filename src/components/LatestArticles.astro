---
import { getCollection } from "astro:content";

const articles = (await getCollection("articles"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="articles-section section" id="articles">
  <div class="container">
    <div class="section-heading articles-heading" data-reveal>
      <div>
        <p class="eyebrow">Artikel Terbaru</p>

        <h2>
          Cerita dan informasi dari kami
        </h2>

        <p>
          Temukan artikel, tips, cerita, dan informasi terbaru
          dari Bunga Ice.
        </p>
      </div>

      <a href="/blog/" class="view-all">
        Lihat Semua Artikel
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="articles-grid">
      {
        articles.length > 0 ? (
          articles.map((article, index) => (
            <article
              class="article-card"
              data-reveal
              style={`--reveal-delay: ${index * 80}ms`}
            >
              <a href={`/blog/${article.data.slug}/`} class="article-image">
                {article.data.image ? (
                  <img
                    src={article.data.image}
                    alt={article.data.title}
                    loading="lazy"
                  />
                ) : (
                  <div class="article-image-placeholder" aria-hidden="true">
                    <span>Artikel Bunga Ice</span>
                  </div>
                )}
              </a>

              <div class="article-content">
                <div class="article-meta">
                  <span>{article.data.category}</span>
                  <time datetime={article.data.date.toISOString()}>
                    {article.data.date.toLocaleDateString("id-ID", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    })}
                  </time>
                </div>

                <h3>
                  <a href={`/blog/${article.data.slug}/`}>{article.data.title}</a>
                </h3>

                <p>{article.data.excerpt}</p>

                <a href={`/blog/${article.data.slug}/`} class="read-more">
                  Baca Artikel
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        ) : (
          <div class="empty-state" data-reveal>
            <p>Belum ada artikel yang tersedia.</p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .articles-section {
    background: var(--color-muted);
  }

  .articles-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .view-all {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .view-all span,
  .read-more span {
    transition: transform 180ms ease;
  }

  .view-all:hover span,
  .read-more:hover span {
    transform: translateX(4px);
  }

  .articles-grid {
    display: grid;
    gap: 20px;
  }

  .article-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .article-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-muted);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .article-card:hover .article-image img {
    transform: scale(1.04);
  }

  .article-image-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  .article-content {
    padding: 24px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .article-meta span {
    color: var(--color-primary);
    font-weight: 700;
  }

  .article-content h3 {
    margin-bottom: 12px;
    font-size: 1.35rem;
  }

  .article-content h3 a:hover {
    color: var(--color-primary);
  }

  .article-content p {
    margin-bottom: 20px;
    color: var(--color-text-soft);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .read-more span {
    transition: transform 180ms ease;
  }

  .read-more:hover span {
    transform: translateX(4px);
  }

  .empty-state {
    padding: 40px 20px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-align: center;
  }

  .empty-state p {
    margin-bottom: 0;
    color: var(--color-text-soft);
  }

  @media (max-width: 699px) {
    .articles-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (min-width: 700px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
