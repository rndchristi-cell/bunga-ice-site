---
const articles = [
  {
    title: "Mengenal Bunga Ice Lebih Dekat",
    excerpt:
      "Cerita singkat tentang Bunga Ice, latar belakang, dan apa yang kami tawarkan.",
    date: "12 September 2026",
    category: "Tentang Kami",
    image: "/images/article-1.jpg",
    href: "/blog/mengenal-bunga-ice/",
  },
  {
    title: "Tips Memilih Produk yang Tepat",
    excerpt:
      "Beberapa hal yang bisa diperhatikan sebelum memilih produk sesuai kebutuhan.",
    date: "8 September 2026",
    category: "Tips",
    image: "/images/article-2.jpg",
    href: "/blog/tips-memilih-produk/",
  },
  {
    title: "Cerita dan Aktivitas Bunga Ice",
    excerpt:
      "Berbagai cerita, aktivitas, dan informasi terbaru dari Bunga Ice.",
    date: "3 September 2026",
    category: "Cerita",
    image: "/images/article-3.jpg",
    href: "/blog/cerita-dan-aktivitas-bunga-ice/",
  },
];
---

<section class="articles-section section" id="articles">
  <div class="container">
    <div class="section-heading articles-heading">
      <div>
        <p class="eyebrow">Artikel Terbaru</p>

        <h2>
          Cerita dan informasi dari kami
        </h2>

        <p>
          Temukan artikel, tips, cerita, dan informasi terbaru
          dari Bunga Ice.
        </p>
      </div>

      <a href="/blog/" class="view-all">
        Lihat Semua Artikel
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="articles-grid">
      {
        articles.map((article) => (
          <article class="article-card">
            <a href={article.href} class="article-image">
              <img
                src={article.image}
                alt={article.title}
                loading="lazy"
              />
            </a>

            <div class="article-content">
              <div class="article-meta">
                <span>{article.category}</span>
                <time>{article.date}</time>
              </div>

              <h3>
                <a href={article.href}>{article.title}</a>
              </h3>

              <p>{article.excerpt}</p>

              <a href={article.href} class="read-more">
                Baca Artikel
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .articles-section {
    background: var(--color-muted);
  }

  .articles-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }

  .view-all {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .view-all span,
  .read-more span {
    transition: transform 180ms ease;
  }

  .view-all:hover span,
  .read-more:hover span {
    transform: translateX(4px);
  }

  .articles-grid {
    display: grid;
    gap: 20px;
  }

  .article-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .article-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-muted);
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .article-card:hover .article-image img {
    transform: scale(1.04);
  }

  .article-content {
    padding: 24px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--color-text-soft);
    font-size: 0.8rem;
  }

  .article-meta span {
    color: var(--color-primary);
    font-weight: 700;
  }

  .article-content h3 {
    margin-bottom: 12px;
    font-size: 1.35rem;
  }

  .article-content h3 a:hover {
    color: var(--color-primary);
  }

  .article-content p {
    margin-bottom: 20px;
    color: var(--color-text-soft);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.95rem;
  }

  @media (max-width: 699px) {
    .articles-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (min-width: 700px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
