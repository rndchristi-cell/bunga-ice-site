---
const galleryItems = [
  {
    title: "Suasana Bunga Ice",
    image: "/images/gallery-1.jpg",
  },
  {
    title: "Produk Unggulan",
    image: "/images/gallery-2.jpg",
  },
  {
    title: "Aktivitas Kami",
    image: "/images/gallery-3.jpg",
  },
  {
    title: "Momen Bersama Pelanggan",
    image: "/images/gallery-4.jpg",
  },
];
---

<section class="gallery-section section" id="gallery">
  <div class="container">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Gallery</p>

      <h2>
        Lihat lebih dekat Bunga Ice
      </h2>

      <p>
        Beberapa foto yang menggambarkan produk, aktivitas,
        suasana, dan berbagai momen dari Bunga Ice.
      </p>
    </div>

    <div class="gallery-grid">
      {
        galleryItems.map((item, index) => (
          <article
            class="gallery-item"
            data-reveal="image"
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <div class="gallery-image">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
              />
            </div>

            <div class="gallery-caption">
              <h3>{item.title}</h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-section {
    background: var(--color-bg);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-muted);
    box-shadow: var(--shadow-sm);
  }

  .gallery-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 350ms ease;
  }

  .gallery-item:hover .gallery-image img {
    transform: scale(1.04);
  }

  .gallery-caption {
    padding: 18px 20px;
    background: var(--color-surface);
  }

  .gallery-caption h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
