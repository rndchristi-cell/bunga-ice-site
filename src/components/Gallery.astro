---
import { getCollection } from "astro:content";

const galleryItems = (await getCollection("gallery"))
  .filter((item) => item.data.active)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="gallery-section section" id="gallery">
  <div class="container">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Gallery</p>

      <h2>Lihat lebih dekat Bunga Ice</h2>

      <p>
        Beberapa foto yang menggambarkan produk, aktivitas, suasana,
        dan berbagai momen dari Bunga Ice.
      </p>
    </div>

    <div class="gallery-grid">
      {
        galleryItems.map((item, index) => (
          <article
            class="gallery-item"
            data-reveal="image"
            style={`--reveal-delay: ${index * 70}ms`}
          >
            <div class="gallery-image">
              <img
                src={item.data.image}
                alt={item.data.title}
                loading="lazy"
              />
            </div>

            <div class="gallery-caption">
              <h3>{item.data.title}</h3>
              {item.data.description ? <p>{item.data.description}</p> : null}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery-section {
    background: var(--color-bg);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-muted);
    box-shadow: var(--shadow-sm);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .gallery-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 350ms ease;
  }

  .gallery-item:hover .gallery-image img {
    transform: scale(1.04);
  }

  .gallery-caption {
    padding: 18px 20px;
    background: var(--color-surface);
  }

  .gallery-caption h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .gallery-caption p {
    margin: 8px 0 0;
    color: var(--color-text-soft);
    font-size: 0.92rem;
  }

  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
